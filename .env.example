# Copy to .env and fill in. .env is gitignored; never commit real values.
# None of this is needed for demo mode (DEMO_MODE=true).

# Postgres connection string. Unset falls back to a local SQLite file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Meta Marketing API, read-only (ads_read). Use a system-user token: plain
# user tokens expire after about 60 days and would silently stop the ingest.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_IDS=act_1111111111,act_2222222222
META_APP_ID=
META_APP_SECRET=

# Serve a seeded fictional portfolio instead of the real store.
DEMO_MODE=false

# The deployed dashboard's origin, allowed through CORS. Not needed locally.
FRONTEND_ORIGIN=
